{
  "$defs": {
    "DataCatalogEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9.-]{2,99}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "foundation",
            "character_creation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "pattern": "^[a-z0-9][a-z0-9./_-]*\\.json$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "sha256"
      ],
      "title": "DataCatalogEntry",
      "type": "object"
    },
    "RegistryEntry": {
      "additionalProperties": false,
      "properties": {
        "data_catalogs": {
          "items": {
            "$ref": "#/$defs/DataCatalogEntry"
          },
          "minItems": 1,
          "title": "Data Catalogs",
          "type": "array"
        },
        "default_data_catalog_id": {
          "title": "Default Data Catalog Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$",
          "title": "Id",
          "type": "string"
        },
        "manifest": {
          "pattern": "^[a-z0-9][a-z0-9./-]*\\.json$",
          "title": "Manifest",
          "type": "string"
        }
      },
      "required": [
        "id",
        "manifest",
        "default_data_catalog_id",
        "data_catalogs"
      ],
      "title": "RegistryEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "default_release_id": {
      "title": "Default Release Id",
      "type": "string"
    },
    "releases": {
      "items": {
        "$ref": "#/$defs/RegistryEntry"
      },
      "minItems": 1,
      "title": "Releases",
      "type": "array"
    },
    "schema_version": {
      "const": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "default_release_id",
    "releases"
  ],
  "title": "RegistryDocument",
  "type": "object"
}
