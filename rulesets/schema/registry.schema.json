{
  "$defs": {
    "RegistryEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$",
          "title": "Id",
          "type": "string"
        },
        "manifest": {
          "pattern": "^[a-z0-9][a-z0-9./-]*\\.json$",
          "title": "Manifest",
          "type": "string"
        }
      },
      "required": [
        "id",
        "manifest"
      ],
      "title": "RegistryEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "default_release_id": {
      "title": "Default Release Id",
      "type": "string"
    },
    "releases": {
      "items": {
        "$ref": "#/$defs/RegistryEntry"
      },
      "minItems": 1,
      "title": "Releases",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "default_release_id",
    "releases"
  ],
  "title": "RegistryDocument",
  "type": "object"
}
