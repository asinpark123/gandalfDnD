{
  "$defs": {
    "ResolutionRuleDefinition": {
      "additionalProperties": false,
      "properties": {
        "beginner_description": {
          "title": "Beginner Description",
          "type": "string"
        },
        "definition_key": {
          "pattern": "^srd-5\\.2\\.1:[a-z0-9][a-z0-9._-]+$",
          "title": "Definition Key",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "definition_key",
        "name",
        "beginner_description",
        "source_ids"
      ],
      "title": "ResolutionRuleDefinition",
      "type": "object"
    },
    "ResolutionRuleSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$",
          "title": "Id",
          "type": "string"
        },
        "printed_pages": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Printed Pages",
          "type": "array"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "section",
        "printed_pages",
        "url"
      ],
      "title": "ResolutionRuleSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "base_character_state_catalog_id": {
      "const": "srd-5.2.1-party-state-v1",
      "title": "Base Character State Catalog Id",
      "type": "string"
    },
    "base_character_state_catalog_sha256": {
      "const": "aba4fcdbffb037eece88c862c76be988ffc60808b46361cc9a9dda0730fe763b",
      "title": "Base Character State Catalog Sha256",
      "type": "string"
    },
    "id": {
      "const": "srd-5.2.1-check-save-resolution-v1",
      "title": "Id",
      "type": "string"
    },
    "resolver_version": {
      "const": "check-save-resolution-1.0.0",
      "title": "Resolver Version",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/ResolutionRuleDefinition"
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "ruleset_release_id": {
      "const": "srd-5.2.1",
      "title": "Ruleset Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/ResolutionRuleSource"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "ruleset_release_id",
    "base_character_state_catalog_id",
    "base_character_state_catalog_sha256",
    "resolver_version",
    "sources",
    "rules"
  ],
  "title": "ResolutionRulesCatalog",
  "type": "object"
}
