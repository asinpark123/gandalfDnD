{
  "$defs": {
    "EquipmentStateRule": {
      "additionalProperties": false,
      "properties": {
        "armor_category": {
          "anyOf": [
            {
              "enum": [
                "light",
                "medium",
                "heavy"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Armor Category"
        },
        "base_armor_class": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Armor Class"
        },
        "beginner_description": {
          "title": "Beginner Description",
          "type": "string"
        },
        "default_position": {
          "enum": [
            "carried",
            "worn",
            "held"
          ],
          "title": "Default Position",
          "type": "string"
        },
        "definition_key": {
          "pattern": "^srd-5\\.2\\.1:[a-z0-9][a-z0-9._-]+$",
          "title": "Definition Key",
          "type": "string"
        },
        "hands_required": {
          "maximum": 2,
          "minimum": 0,
          "title": "Hands Required",
          "type": "integer"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "item_name": {
          "title": "Item Name",
          "type": "string"
        },
        "item_type": {
          "enum": [
            "armor",
            "weapon"
          ],
          "title": "Item Type",
          "type": "string"
        },
        "minimum_strength": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Strength"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "stealth_disadvantage": {
          "default": false,
          "title": "Stealth Disadvantage",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "definition_key",
        "name",
        "beginner_description",
        "source_ids",
        "item_id",
        "item_name",
        "item_type",
        "hands_required",
        "default_position"
      ],
      "title": "EquipmentStateRule",
      "type": "object"
    },
    "PartyRules": {
      "additionalProperties": false,
      "properties": {
        "control_mode": {
          "const": "player",
          "title": "Control Mode",
          "type": "string"
        },
        "maximum_active_characters": {
          "const": 4,
          "title": "Maximum Active Characters",
          "type": "integer"
        },
        "minimum_active_characters": {
          "const": 2,
          "title": "Minimum Active Characters",
          "type": "integer"
        },
        "mode": {
          "const": "party_commander",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "minimum_active_characters",
        "maximum_active_characters",
        "control_mode"
      ],
      "title": "PartyRules",
      "type": "object"
    },
    "ResourceStateRule": {
      "additionalProperties": false,
      "properties": {
        "beginner_description": {
          "title": "Beginner Description",
          "type": "string"
        },
        "definition_key": {
          "pattern": "^srd-5\\.2\\.1:[a-z0-9][a-z0-9._-]+$",
          "title": "Definition Key",
          "type": "string"
        },
        "die": {
          "anyOf": [
            {
              "pattern": "^d(?:[2-9]|[1-9]\\d{1,2})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Die"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "initial_current": {
          "minimum": 0,
          "title": "Initial Current",
          "type": "integer"
        },
        "long_rest_recovery": {
          "enum": [
            "none",
            "all"
          ],
          "title": "Long Rest Recovery",
          "type": "string"
        },
        "maximum": {
          "exclusiveMinimum": 0,
          "title": "Maximum",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "short_rest_recovery": {
          "enum": [
            "none",
            "one",
            "all"
          ],
          "title": "Short Rest Recovery",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "definition_key",
        "name",
        "beginner_description",
        "source_ids",
        "maximum",
        "initial_current",
        "short_rest_recovery",
        "long_rest_recovery"
      ],
      "title": "ResourceStateRule",
      "type": "object"
    },
    "StateRuleDefinition": {
      "additionalProperties": false,
      "properties": {
        "beginner_description": {
          "title": "Beginner Description",
          "type": "string"
        },
        "definition_key": {
          "pattern": "^srd-5\\.2\\.1:[a-z0-9][a-z0-9._-]+$",
          "title": "Definition Key",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "definition_key",
        "name",
        "beginner_description",
        "source_ids"
      ],
      "title": "StateRuleDefinition",
      "type": "object"
    },
    "StateRuleSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$",
          "title": "Id",
          "type": "string"
        },
        "printed_pages": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Printed Pages",
          "type": "array"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "section",
        "printed_pages",
        "url"
      ],
      "title": "StateRuleSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "base_character_creation_catalog_id": {
      "const": "srd-5.2.1-character-creation-v1",
      "title": "Base Character Creation Catalog Id",
      "type": "string"
    },
    "base_character_creation_catalog_sha256": {
      "const": "ddbd172feeeb191789f1b95f93762c661dda06888dad067e28c7fc6ffda391cb",
      "title": "Base Character Creation Catalog Sha256",
      "type": "string"
    },
    "equipment": {
      "items": {
        "$ref": "#/$defs/EquipmentStateRule"
      },
      "minItems": 1,
      "title": "Equipment",
      "type": "array"
    },
    "id": {
      "const": "srd-5.2.1-party-state-v1",
      "title": "Id",
      "type": "string"
    },
    "party": {
      "$ref": "#/$defs/PartyRules"
    },
    "resolver_version": {
      "const": "character-state-1.0.0",
      "title": "Resolver Version",
      "type": "string"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/ResourceStateRule"
      },
      "minItems": 1,
      "title": "Resources",
      "type": "array"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/StateRuleDefinition"
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "ruleset_release_id": {
      "const": "srd-5.2.1",
      "title": "Ruleset Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/StateRuleSource"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "ruleset_release_id",
    "base_character_creation_catalog_id",
    "base_character_creation_catalog_sha256",
    "resolver_version",
    "party",
    "sources",
    "rules",
    "equipment",
    "resources"
  ],
  "title": "CharacterStateCatalog",
  "type": "object"
}
