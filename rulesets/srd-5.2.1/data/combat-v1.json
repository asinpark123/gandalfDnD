  "rules": [
    {
      "id": "initiative",
      "definition_key": "srd-5.2.1:rule.combat.initiative",
      "name": "Initiative",
      "beginner_description": "Roll a Dexterity check for each combatant and order turns from highest total to lowest.",
      "source_ids": ["srd-combat-core"]
    },
    {
      "id": "attack_roll",
      "definition_key": "srd-5.2.1:rule.combat.attack_roll",
      "name": "Attack Roll",
      "beginner_description": "An attack hits when its d20 total equals or exceeds the target's Armor Class, subject to natural-roll rules.",
      "source_ids": ["srd-combat-core"]
    },
    {
      "id": "natural_one_twenty",
      "definition_key": "srd-5.2.1:rule.combat.natural_one_twenty",
      "name": "Natural 1 and Natural 20",
      "beginner_description": "A natural 1 always misses and a natural 20 always hits and is a Critical Hit.",
      "source_ids": ["srd-combat-core"]
    },
    {
      "id": "critical_hit",
      "definition_key": "srd-5.2.1:rule.combat.critical_hit",
      "name": "Critical Hit",
      "beginner_description": "Roll every damage die of the attack twice and add fixed modifiers only once.",
      "source_ids": ["srd-combat-core"]
    },
    {
      "id": "damage",
      "definition_key": "srd-5.2.1:rule.combat.damage",
      "name": "Damage",
      "beginner_description": "Roll the attack's damage dice, add the applicable modifier, and reduce Hit Points after other defenses.",
      "source_ids": ["srd-combat-core"]
    },
    {
      "id": "resistance",
      "definition_key": "srd-5.2.1:rule.combat.resistance",
      "name": "Resistance",
      "beginner_description": "Resistance halves matching damage, rounding down, before Vulnerability is applied.",
      "source_ids": ["srd-combat-core"]
    },
    {
      "id": "vulnerability",
      "definition_key": "srd-5.2.1:rule.combat.vulnerability",
      "name": "Vulnerability",
      "beginner_description": "Vulnerability doubles matching damage after Resistance is applied.",
      "source_ids": ["srd-combat-core"]
    },
    {
      "id": "healing",
      "definition_key": "srd-5.2.1:rule.combat.healing",
      "name": "Healing",
      "beginner_description": "Healing restores Hit Points up to the creature's Hit Point maximum and does not add Temporary Hit Points.",
      "source_ids": ["srd-combat-core"]
    },
    {
      "id": "temporary_hit_points",
      "definition_key": "srd-5.2.1:rule.combat.temporary_hit_points",
      "name": "Temporary Hit Points",
      "beginner_description": "Temporary Hit Points absorb damage first, never add together, and are not healing.",
      "source_ids": ["srd-combat-core"]
    }
  ],
